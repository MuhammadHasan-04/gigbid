{
 "get_case_study": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "input": {
   "properties": {
    "id": {
     "description": "project id or evidence id",
     "maxLength": 80,
     "minLength": 2,
     "title": "Id",
     "type": "string"
    },
    "portfolio": {
     "anyOf": [
      {
       "maxLength": 40,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Portfolio"
    }
   },
   "required": [
    "id"
   ],
   "title": "get_case_studyArguments",
   "type": "object"
  },
  "output": {
   "properties": {
    "id": {
     "title": "Id",
     "type": "string"
    },
    "related_evidence": {
     "items": {
      "type": "string"
     },
     "title": "Related Evidence",
     "type": "array"
    },
    "skills": {
     "items": {
      "type": "string"
     },
     "title": "Skills",
     "type": "array"
    },
    "text": {
     "title": "Text",
     "type": "string"
    },
    "title": {
     "title": "Title",
     "type": "string"
    }
   },
   "required": [
    "id",
    "title",
    "text",
    "skills",
    "related_evidence"
   ],
   "title": "CaseStudy",
   "type": "object"
  }
 },
 "list_skills": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "input": {
   "properties": {
    "portfolio": {
     "anyOf": [
      {
       "maxLength": 40,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Portfolio"
    }
   },
   "title": "list_skillsArguments",
   "type": "object"
  },
  "output": {
   "$defs": {
    "SkillCount": {
     "properties": {
      "projects": {
       "title": "Projects",
       "type": "integer"
      },
      "skill": {
       "title": "Skill",
       "type": "string"
      }
     },
     "required": [
      "skill",
      "projects"
     ],
     "title": "SkillCount",
     "type": "object"
    }
   },
   "properties": {
    "result": {
     "items": {
      "$ref": "#/$defs/SkillCount"
     },
     "title": "Result",
     "type": "array"
    }
   },
   "required": [
    "result"
   ],
   "title": "list_skillsOutput",
   "type": "object"
  }
 },
 "search_evidence": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "input": {
   "$defs": {
    "Filters": {
     "properties": {
      "industry": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Industry"
      },
      "since_year": {
       "anyOf": [
        {
         "maximum": 2100,
         "minimum": 1990,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Since Year"
      },
      "types": {
       "anyOf": [
        {
         "items": {
          "enum": [
           "cv",
           "case_study",
           "readme",
           "code",
           "review",
           "upload"
          ],
          "type": "string"
         },
         "type": "array"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Types"
      }
     },
     "title": "Filters",
     "type": "object"
    }
   },
   "properties": {
    "filters": {
     "anyOf": [
      {
       "$ref": "#/$defs/Filters"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "k": {
     "default": 5,
     "maximum": 20,
     "minimum": 1,
     "title": "K",
     "type": "integer"
    },
    "portfolio": {
     "anyOf": [
      {
       "maxLength": 40,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "portfolio id; default: the server's",
     "title": "Portfolio"
    },
    "requirement": {
     "description": "a job requirement, e.g. 'Celery task queues'",
     "maxLength": 300,
     "minLength": 2,
     "title": "Requirement",
     "type": "string"
    }
   },
   "required": [
    "requirement"
   ],
   "title": "search_evidenceArguments",
   "type": "object"
  },
  "output": {
   "$defs": {
    "EvidenceItem": {
     "properties": {
      "date": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Date"
      },
      "evidence_id": {
       "title": "Evidence Id",
       "type": "string"
      },
      "industry": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Industry"
      },
      "outcome": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Outcome"
      },
      "project_id": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Project Id"
      },
      "score": {
       "title": "Score",
       "type": "number"
      },
      "skills": {
       "items": {
        "type": "string"
       },
       "title": "Skills",
       "type": "array"
      },
      "snippet": {
       "title": "Snippet",
       "type": "string"
      },
      "source": {
       "title": "Source",
       "type": "string"
      },
      "title": {
       "title": "Title",
       "type": "string"
      },
      "type": {
       "title": "Type",
       "type": "string"
      }
     },
     "required": [
      "evidence_id",
      "type",
      "project_id",
      "title",
      "source",
      "date",
      "industry",
      "skills",
      "snippet",
      "score"
     ],
     "title": "EvidenceItem",
     "type": "object"
    }
   },
   "properties": {
    "items": {
     "items": {
      "$ref": "#/$defs/EvidenceItem"
     },
     "title": "Items",
     "type": "array"
    },
    "note": {
     "default": "",
     "title": "Note",
     "type": "string"
    },
    "requirement": {
     "title": "Requirement",
     "type": "string"
    }
   },
   "required": [
    "requirement",
    "items"
   ],
   "title": "EvidenceResults",
   "type": "object"
  }
 }
}