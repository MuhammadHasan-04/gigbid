    "offset": {
     "default": 0,
     "minimum": 0,
     "title": "Offset",
     "type": "integer"
    },
    "posted_within_min": {
     "anyOf": [
      {
       "maximum": 10080,
       "minimum": 1,
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "only jobs posted in the last N minutes",
     "title": "Posted Within Min"
    },
    "query": {
     "default": "",
     "description": "keywords; all must appear",
     "maxLength": 200,
     "title": "Query",
     "type": "string"
    }
   },
   "title": "search_jobsArguments",
   "type": "object"
  },
  "output": {
   "properties": {
    "error": {
