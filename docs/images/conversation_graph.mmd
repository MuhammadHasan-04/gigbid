---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	load_thread(load_thread)
	classify(classify)
	slots(slots)
	draft(draft)
	compliance(compliance)
	approval(approval)
	send(send)
	__end__([<p>__end__</p>]):::last
	__start__ --> load_thread;
	approval -.-> __end__;
	approval -.-> send;
	classify -.-> draft;
	classify -.-> slots;
	compliance --> approval;
	draft --> compliance;
	load_thread --> classify;
	slots --> draft;
	send --> __end__;
	approval -.-> approval;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
