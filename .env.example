# Copy to .env and fill in. Never commit .env.
APP_ENV=development
APP_SECRET_KEY=change-me-long-random-string
TOKEN_ENC_KEY=                      # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
APPROVAL_SECRET=change-me-too
DATABASE_URL=postgresql://gigbid:gigbid@localhost:5432/gigbid
REDIS_URL=redis://localhost:6379/0
RUN_INLINE=0                        # 1 = run background work inside the API process (single-container deploy)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Marketplace
MARKETPLACE_MODE=gigsim             # gigsim | upwork_live
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_API_TOKEN=gigsim-dev-token
GIGSIM_ADMIN_TOKEN=gigsim-admin-token
POLICY_VERSION=1
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REDIRECT_URI=http://localhost:8000/api/auth/upwork/callback

# MCP servers (bearer tokens "token:user,...")
MCP_TRANSPORT=inproc                # inproc | http
MARKETPLACE_MCP_TOKENS=dev-marketplace-token:demo
PORTFOLIO_MCP_TOKENS=dev-portfolio-token:demo
WORKSPACE_MCP_TOKENS=dev-workspace-token:demo
GITHUB_PERSONAL_ACCESS_TOKEN=       # GitHub MCP server (repo ingestion)

# Models: open profile = hosted open-weight models (free tier) or local Ollama
MODEL_PROFILE=open                  # open | open_local | paid | heuristic
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Reviewer login seeded at startup (put real values in the deployment's secret store only)
REVIEWER_EMAIL=
REVIEWER_PASSWORD=
REVIEWER_PERSONA=ai_ml
